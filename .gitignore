# Build outputs
/target/
/android/.gradle/
/android/build/
/android/app/build/
/android/local.properties

# Release artifacts (built by scripts/package-dist.sh; shipped via GitHub Releases)
/dist/
/KetraCopy-portable/

# Session / tooling junk
/tool-results/
/.clawhub/
*.state

# Gate 3 vendor-material guard (ADR-0003): research material NEVER enters
# the repo — vendor binaries (TeraCopy 3.17/4.0.5 study) and raw OS-trace
# exports live outside the repo (/home/z/my-project/research/). The backup
# pre-flight (harness/scripts/backup.sh) independently aborts on executable
# / OLE magic bytes in staged files — this ignore list is layer 1 of 2.
/research/
*.pml
*.etl
*.exe
*.dll
*.msi
*.sys

# Editors / OS
*.swp
.DS_Store
