<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleDisplayName</key>
	<string>KetraCopy</string>
	<!-- Main (GUI) executable. make-app.sh rewrites this to "ketra" when
	     only the CLI binary exists. -->
	<key>CFBundleExecutable</key>
	<string>ketra-gui</string>
	<key>CFBundleIdentifier</key>
	<string>io.github.ketracopy.KetraCopy</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>KetraCopy</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>1.1.0</string>
	<key>CFBundleVersion</key>
	<string>1.1.0</string>
	<!-- macOS 10.15 Catalina or newer -->
	<key>LSMinimumSystemVersion</key>
	<string>10.15</string>
	<key>LSApplicationCategoryType</key>
	<string>public.app-category.utilities</string>
	<key>NSHighResolutionCapable</key>
	<true/>
	<!-- Regular dock app (not a background agent) -->
	<key>LSUIElement</key>
	<false/>
	<!-- No document types (CFBundleDocumentTypes): KetraCopy accepts files
	     via drag & drop onto the GUI, the CLI, or the Finder Quick Action,
	     not via Open With. Add CFBundleDocumentTypes here if that changes. -->
</dict>
</plist>
